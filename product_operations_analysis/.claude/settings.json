{
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "Bash(python3:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "mcp-service"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-mcp-only.sh"
          }
        ]
      }
    ]
  }
}
